<h1>Edit Book</h1>

<% if flash[:alert] %>
  <p><%= flash[:alert] %></p>
<% end %>

<% if @book.errors.any? %>
  <p>error: <%= @book.errors.full_messages.join(", ") %></p>
<% end %>

<%= form_with model: @book, local: true do |f| %>
  <p>Title: <%= f.text_field :title %></p>
  <p>Body: <%= f.text_area :body %></p>
  <%= f.submit "Update Book" %>
<% end %>

<%= link_to "Show", book_path(@book) %>
<%= link_to "Back", books_path %>
