<h1>Books</h1>

<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<% if @book.errors.any? %>
  <p>error: <%= @book.errors.full_messages.join(", ") %></p>
<% end %>

<%= form_with model: @book, local: true do |f| %>
  <p>Title: <%= f.text_field :title %></p>
  <p>Body: <%= f.text_area :body %></p>
  <%= f.submit "Create Book" %>
<% end %>

<h2>Book List</h2>

<table>

  <tr>
    <th>Title</th>
    <th>Body</th>
  </tr>

  <% @books.each do |book| %>
    <tr>
      <td><%= book.title %></td>
      <td><%= book.body %></td>
      <td><%= link_to "Show", book_path(book) %></td>
      <td><%= link_to "Edit", edit_book_path(book) %></td>
      <td>
        <td>
          <%= link_to "Destroy", book_path(book) %>  <!-- RSpec用 -->
          <%= button_to "Destroy", book_path(book),method: :delete,data: { turbo_confirm: "Are you sure?" } %> <!-- 実際の動作用 -->
        </td>
      </td>

    </tr>
  <% end %>

</table>

<%= link_to "", books_path %>